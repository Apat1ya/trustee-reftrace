    {
      "id": 9,
      "type": "timeseries",
      "title": "Browser lanes busy and idle over time",
      "description": "Lane-seconds per interval, stacked: in visits, and idle until a task came or until the run ended. The top of the stack is lanes x interval; a gap below it is time between visits. Each span counts in the interval it started in.",
      "datasource": {
        "type": "tempo",
        "uid": "reftrace-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "reftrace-tempo"
          },
          "queryType": "traceql",
          "query": "{(name=\"visit\" || name=\"lane.idle\") && span.reftrace.run.id=\"$run\"} | sum_over_time(duration) by (name, span.reftrace.idle.ended)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "maxDataPoints": 120,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^visit$",
            "renamePattern": "busy in visits"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*idle.ended=\"?([a-z-]+)\"?.*",
            "renamePattern": "idle until $1"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Time by stage",
      "description": "Seconds spent in each stage over the whole run. Stages nest (a step holds its load, settle and reveal; the scan holds the exit clicks), so the bars do not add up to the run.",
      "datasource": {
        "type": "tempo",
        "uid": "reftrace-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "reftrace-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"visit\" && span.reftrace.run.id=\"$run\"} >> {name != \"attempt\"} | sum_over_time(duration) by (name)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "maxDataPoints": 100,
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "sum"
            ],
            "labelsToFields": false,
            "mode": "seriesToRows"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Total$/",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 22
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Time lost to timeouts by stage",
      "description": "Seconds of stages whose wait ran out, by stage and by what it waited for: document (page load), actionable (a followed link that never became clickable), reaction (a click after which nothing happened), hover and menu (uncovering a link), reveal (the reveal budget).",
      "datasource": {
        "type": "tempo",
        "uid": "reftrace-tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "reftrace-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"visit\" && span.reftrace.run.id=\"$run\"} >> {span.reftrace.wait.outcome=\"timeout\"} | sum_over_time(duration) by (name, span.reftrace.wait.for)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "maxDataPoints": 100,
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*name=\"([^\"]+)\".*wait.for=\"([^\"]+)\".*",
            "renamePattern": "$1 ($2)"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 22
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Exit clicks after which nothing happened",
      "description": "Seconds waited by exit clicks after which nothing happened, by link and element, most first. Each such click waits the whole limits.action.click-navigation (2 s) for a navigation that never comes.",
      "datasource": {
        "type": "tempo",
        "uid": "reftrace-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "reftrace-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"visit\" && span.reftrace.run.id=\"$run\"} >> {name=\"page.exit-click\" && span.reftrace.click=\"no-navigation\"} | sum_over_time(duration) by (span.reftrace.href, span.reftrace.selector)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "maxDataPoints": 100,
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "sum"
            ],
            "labelsToFields": true,
            "mode": "seriesToRows"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "renameByName": {
              "span.reftrace.href": "link",
              "span.reftrace.selector": "element",
              "Total": "seconds waited"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Repeated work",
      "description": "Seconds of work done again: attempts thrown away for a retry (by why), and steps that only replay the way to the page a visit continues from (by step).",
      "datasource": {
        "type": "tempo",
        "uid": "reftrace-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "reftrace-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"visit\" && span.reftrace.run.id=\"$run\"} >> {(name=\"attempt\" && span.reftrace.retried=\"true\") || span.reftrace.replay=\"true\"} | sum_over_time(duration) by (name, span.reftrace.retry.reason)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "maxDataPoints": 100,
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": ".*retry.reason=\"([^\"]+)\".*",
            "renamePattern": "attempts retried for $1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(step[.].+)$",
            "renamePattern": "$1 steps replayed"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
