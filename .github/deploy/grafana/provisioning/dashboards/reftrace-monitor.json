{
  "uid": "reftrace-monitor",
  "title": "Reftrace monitor",
  "description": "Whether the daily referral check runs, when it last ended, whether its result can be trusted and what it found. The monitor pushes its metrics; every process is an instance of its own, so the last run is looked up in the history, not in the current values.",
  "tags": [
    "reftrace"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Monitor running",
      "description": "Whether the monitor pushed its metrics in the last five minutes. Down means nothing is checking the links.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "count(process_uptime_milliseconds{job=\"trustee-reftrace\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last run",
      "description": "How the newest run ended: ok (a report without mismatches), issues_found (a report with mismatches: the monitor worked and the site has a problem) or no_report (the run stopped without writing one).",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "last_over_time(reftrace_run_last_status[30d]) == 1 and on (instance) topk(1, last_over_time(reftrace_run_last_finish_timestamp_seconds[30d]))",
          "instant": true,
          "range": false,
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "no run yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "issues_found"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no_report"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Run in progress",
      "description": "Whether a run has started and not ended yet. One that stays in progress for more than seven hours is stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "count((reftrace_run_last_start_timestamp_seconds unless on (instance) reftrace_run_last_finish_timestamp_seconds) or (reftrace_run_last_start_timestamp_seconds > on (instance) reftrace_run_last_finish_timestamp_seconds)) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "text",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "Yes",
                  "color": "blue",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last run ended",
      "description": "When the newest run ended, with or without a report.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 13,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "max(last_over_time(reftrace_run_last_finish_timestamp_seconds[30d])) * 1000",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "noValue": "never"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Since the last run with a report",
      "description": "Time since the newest run that ended with a report, mismatches or not. Red past 26 hours, when the alert fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 17,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "time() - max(last_over_time(reftrace:run_last_success_timestamp_seconds[30d]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "never",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Key lost or replaced",
      "description": "Links of the newest run with a report whose referral key was lost or replaced. The details are in that run's report.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 21,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "sum(last_over_time(reftrace_run_last_checks{outcome=\"mismatch\"}[30d]) and on (instance) topk(1, last_over_time(reftrace_run_last_finish_timestamp_seconds[30d]) and on (instance) last_over_time(reftrace_run_last_pages[30d])))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "no report yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pages visited",
      "description": "Distinct pages each run with a report visited. A run far below the week's most (under 70 percent) sets off the coverage alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "max by (job) (reftrace_run_last_pages)",
          "legendFormat": "pages"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checks that could not be done",
      "description": "Share of the checks of each run with a report that the monitor itself failed (a crashed browser, a page that did not load, the run's time running out) and that the site kept from being tested (an error status, a QR code not shown or not readable). Above 10 percent failed by the monitor, the run is not trustworthy and alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "reftrace-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "max by (job) (sum by (job, instance) (reftrace_run_last_checks{outcome=\"failed\"}) / sum by (job, instance) (reftrace_run_last_checks))",
          "legendFormat": "failed by the monitor"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "reftrace-prometheus"
          },
          "expr": "max by (job) (sum by (job, instance) (reftrace_run_last_checks{outcome=\"untested\"}) / sum by (job, instance) (reftrace_run_last_checks))",
          "legendFormat": "kept from testing by the site"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
