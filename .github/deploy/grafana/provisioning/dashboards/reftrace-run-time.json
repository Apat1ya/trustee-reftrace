        "description": "The duration from which a visit is listed as slow."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Busy in visits",
      "description": "Lane-seconds the browsers spent on visits: the sum of the durations of the run's visit traces.",
      "datasource": {
        "type": "tempo",
        "uid": "reftrace-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "reftrace-tempo"
          },
          "queryType": "traceql",
          "query": "{name=\"visit\" && span.reftrace.run.id=\"$run\"} | sum_over_time(duration)",
          "limit": 20,
          "tableType": "traces",
          "metricsQueryType": "range"
        }
      ],
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
