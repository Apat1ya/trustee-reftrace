{
  "uid": "reftrace-run-time",
  "title": "Where the run's time goes",
  "description": "Where a run's browser time went, from the traces in Tempo: busy and idle lanes, time by stage, time lost to timeouts, exit clicks that went nowhere and repeated work.",
  "tags": [
    "reftrace",
    "traces"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "timezone": "",
  "links": [
    {
      "title": "This run in Traces Drilldown",
      "type": "link",
      "url": "/a/grafana-exploretraces-app/explore?var-ds=reftrace-tempo&var-primarySignal=nestedSetParent%3C0&var-filters=span.reftrace.run.id%7C%3D%7C${run}&var-metric=duration&actionView=breakdown",
      "targetBlank": true,
      "icon": "external link",
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "reftrace-tempo"
        },
        "query": {
          "label": "span.reftrace.run.id",
          "refId": "TempoDatasourceVariableQueryEditor-VariableQuery",
          "type": 1
        },
        "definition": "span.reftrace.run.id",
        "refresh": 2,
        "sort": 2,
        "includeAll": false,
        "multi": false,
        "description": "Runs with traces in the time range; pick a range that covers the whole run."
      },
      {
        "name": "slow",
        "label": "Slow visit",
        "type": "custom",
        "query": "5s,10s,20s,30s,60s",
        "current": {
          "text": "10s",
          "value": "10s"
        },
        "options": [
          {
            "text": "5s",
            "value": "5s",
            "selected": false
          },
          {
            "text": "10s",
            "value": "10s",
            "selected": true
          },
          {
            "text": "20s",
            "value": "20s",
            "selected": false
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
